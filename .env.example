# ------------------------------------------------------------------
# Kopirati ovaj fajl u .env i popuniti vrednosti:  cp .env.example .env
# Fajl .env se NE komituje (nalazi se u .gitignore) jer sadrzi tajne.
# ------------------------------------------------------------------

# --- Baza podataka ---
# Lokalno: Postgres iz Docker Compose-a (servis se zove "db").
# Ako se Postgres pokrece direktno na racunaru, umesto "db" ide "localhost".
DATABASE_URL="postgresql://ekarton:ekarton@localhost:5432/ekarton?schema=public"

# Kredencijali koje Docker Compose koristi za kreiranje Postgres kontejnera.
POSTGRES_USER="ekarton"
POSTGRES_PASSWORD="ekarton"
POSTGRES_DB="ekarton"

# --- NextAuth ---
# Tajni kljuc kojim se potpisuju JWT tokeni sesije.
# Novi kljuc se generise komandom:  openssl rand -base64 32
NEXTAUTH_SECRET="promeniti-ovu-vrednost-u-nasumican-kljuc"

# Puna adresa aplikacije. Lokalno je http://localhost:3000,
# na Vercelu se postavlja na adresu deploy-ovane aplikacije.
NEXTAUTH_URL="http://localhost:3000"
