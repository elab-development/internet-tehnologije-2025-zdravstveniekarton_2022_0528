// Prisma sema je jedinstven izvor istine o strukturi baze.
// Iz nje se generise tipizovan klijent (prisma generate) i migracije (prisma migrate).

generator client {
  provider      = "prisma-client-js"
  // "native" je engine za masinu na kojoj se razvija (Windows/macOS), a
  // "linux-musl-openssl-3.0.x" je engine za Alpine Linux u Docker kontejneru.
  // Bez ovog drugog, Prisma u kontejneru ne moze da ucita svoj engine.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Uloge u sistemu. Svaka odredjuje sta korisnik sme da radi (vidi middleware.ts).
enum Role {
  ADMIN // administrator ustanove - upravlja nalozima
  DOCTOR // lekar - kreira preglede, dijagnoze i recepte
  NURSE // medicinska sestra - termini, laboratorijski nalazi
  PATIENT // pacijent - vidi iskljucivo sopstveni karton
}

// Zivotni ciklus termina: pacijent trazi -> osoblje potvrdjuje -> pregled se obavlja.
enum AppointmentStatus {
  REQUESTED // pacijent poslao zahtev za termin
  CONFIRMED // sestra ili doktor potvrdili termin
  COMPLETED // pregled obavljen
  CANCELLED // termin otkazan
}

enum LabResultStatus {
  PENDING // doktor narucio nalaz, rezultat jos nije unet
  COMPLETED // sestra unela rezultat
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
}

// Zajednicki nalog za sve uloge. Podaci specificni za pacijenta odnosno doktora
// nalaze se u odvojenim profilnim tabelama (dodaju se u sledecoj migraciji).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String // nikada se ne vraca kroz API - cuva se samo bcrypt hes
  fullName     String
  role         Role     @default(PATIENT)
  phone        String?
  // Deaktiviran nalog ostaje u bazi, ali se vlasnik ne moze prijaviti.
  // Nalog se NE brise, jer bi se time izgubila veza sa pregledima i nalazima
  // koje je taj korisnik uneo - medicinska dokumentacija mora ostati citljiva.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Korisnik ima najvise jedan profil, i to onaj koji odgovara njegovoj ulozi.
  patientProfile PatientProfile?
  doctorProfile  DoctorProfile?

  // Isti korisnik moze biti i pacijent i doktor u tabeli termina, pa se relacije
  // moraju imenovati da bi Prisma znala koja kolona vodi ka kojoj strani.
  appointmentsAsPatient Appointment[]   @relation("PatientAppointments")
  appointmentsAsDoctor  Appointment[]   @relation("DoctorAppointments")
  medicalRecords        MedicalRecord[] @relation("DoctorRecords")
  labResultsRequested   LabResult[]     @relation("DoctorLabRequests")
  labResultsUploaded    LabResult[]     @relation("NurseUploads")
}

// Podaci koji postoje samo za pacijenta. Odvojeni su od naloga da tabela User
// ne bi bila puna kolona koje su za doktore i sestre uvek prazne.
model PatientProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  // Jedan JMBG moze pripadati samo jednom pacijentu - sprecava dvostruki karton.
  jmbg                  String   @unique
  dateOfBirth           DateTime
  bloodType             String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  insuranceNumber       String?
  createdAt             DateTime @default(now())

  // onDelete: Cascade - brisanjem naloga nestaje i njegov profil, jer profil
  // bez naloga nema smisla i ostao bi kao "siroce" u bazi.
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicalRecords MedicalRecord[]
  labResults     LabResult[]
  allergies      Allergy[]
}

// Podaci koji postoje samo za lekara.
model DoctorProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  specialization String
  // Broj licence je jedinstven na nivou drzave, pa i u nasoj bazi.
  licenseNumber  String   @unique
  officeRoom     String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Zakazani termin kod lekara. Pacijent ga trazi, osoblje potvrdjuje ili otkazuje.
model Appointment {
  id             String            @id @default(cuid())
  patientId      String
  doctorId       String
  scheduledAt    DateTime
  reasonForVisit String
  status         AppointmentStatus @default(REQUESTED)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  patient       User           @relation("PatientAppointments", fields: [patientId], references: [id])
  doctor        User           @relation("DoctorAppointments", fields: [doctorId], references: [id])
  medicalRecord MedicalRecord?

  // Termini se skoro uvek traze po datumu i po statusu, pa indeks nad tim
  // kolonama znatno ubrzava listu termina kada podataka bude vise.
  @@index([scheduledAt])
  @@index([status])
}

// Jedan pregled u kartonu pacijenta - srce cele aplikacije.
model MedicalRecord {
  id               String   @id @default(cuid())
  appointmentId    String?  @unique
  patientProfileId String
  doctorId         String
  visitDate        DateTime @default(now())
  symptoms         String
  // ICD-10 sifra izabrana preko eksternog NIH servisa. Opciona je, jer lekar
  // sme da upise dijagnozu i bez sifre (npr. ako servis nije dostupan).
  diagnosisCode    String?
  diagnosisName    String
  therapyNotes     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Termin je opcion: pregled moze nastati i bez prethodnog zakazivanja (hitan slucaj).
  appointment    Appointment?   @relation(fields: [appointmentId], references: [id])
  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id])
  doctor         User           @relation("DoctorRecords", fields: [doctorId], references: [id])
  prescriptions  Prescription[]
  // Nalazi naruceni tokom ovog pregleda. Pregled tako postaje celina:
  // dijagnoza, propisana terapija i trazene analize na jednom mestu.
  labResults     LabResult[]

  // Karton pacijenta se uvek ucitava po pacijentu i redja po datumu pregleda.
  @@index([patientProfileId, visitDate])
}

// Lek propisan u okviru jednog pregleda. Jedan pregled moze imati vise lekova.
model Prescription {
  id              String   @id @default(cuid())
  medicalRecordId String
  medicationName  String
  dosage          String
  frequency       String
  durationDays    Int
  notes           String?
  createdAt       DateTime @default(now())

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
}

// Laboratorijski nalaz: doktor ga narucuje, sestra unosi rezultat.
model LabResult {
  id                  String          @id @default(cuid())
  patientProfileId    String
  // Pregled iz kog je analiza narucena. Opciono je, jer se analiza sme naruciti
  // i nezavisno od pregleda (sistematski pregled, analiza pre dolaska lekaru).
  medicalRecordId     String?
  requestedByDoctorId String
  uploadedByNurseId   String?
  testType            String
  resultValue         String?
  resultUnit          String?
  referenceRange      String?
  status              LabResultStatus @default(PENDING)
  testDate            DateTime        @default(now())
  createdAt           DateTime        @default(now())

  patientProfile    PatientProfile @relation(fields: [patientProfileId], references: [id])
  medicalRecord     MedicalRecord? @relation(fields: [medicalRecordId], references: [id])
  requestedByDoctor User           @relation("DoctorLabRequests", fields: [requestedByDoctorId], references: [id])
  uploadedByNurse   User?          @relation("NurseUploads", fields: [uploadedByNurseId], references: [id])
}

// Alergija pacijenta - prikazuje se kao upozorenje pri svakom pregledu.
model Allergy {
  id               String          @id @default(cuid())
  patientProfileId String
  allergen         String
  severity         AllergySeverity @default(MILD)
  notes            String?
  createdAt        DateTime        @default(now())

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
}
